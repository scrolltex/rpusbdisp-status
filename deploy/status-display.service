[Unit]
Description=Server status on RoboPeak USB display
After=docker.service
Wants=docker.service

[Service]
Type=simple
User=statusdisp
# Change --rotate to 180 if the display is mounted upside down.
# Add --color-order rgb if red and blue are swapped, --swap-bytes if colours are garbled.
ExecStart=/usr/local/bin/rpusbdisp-status --backend rpusbdisp --rotate 0
Restart=always
RestartSec=3
TimeoutStopSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
